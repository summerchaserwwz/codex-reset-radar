# Optional. Leave empty to run without X API.
X_BEARER_TOKEN=

# Optional comma-separated free RSS templates. Use {handle} as placeholder.
FREE_RSS_TEMPLATES=https://nitter.net/{handle}/rss,https://xcancel.com/{handle}/rss,https://rss.xcancel.com/{handle}/rss,https://rsshub.app/x/user/{handle},https://rsshub.app/twitter/user/{handle}
